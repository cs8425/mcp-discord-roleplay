# Copy to .env and fill in. The token is read ONLY from the environment (or this
# file) — never from a command line value, so it cannot leak through `ps`.
# .env is git-ignored; it is applied without overriding variables you exported
# yourself (real environment wins).

DISCORD_TOKEN=Bot 0123456789abcdef.GHIJKL.mnopqrstuvwxyz0123456789

# Any command line flag can also be set here as MCPDR_<FLAG, dashes → underscores>.
# Command line beats environment beats this file.
# MCPDR_AGENT=default
# The string stamped in front of every tool name as it is registered. Empty (the
# default) keeps them bare: poll / send / status -- which is what a client that
# namespaces its own tools wants (dc_poll, ...). Set it to discord_ only if one
# agent hangs several bridges on the same socket and needs them told apart.
# MCPDR_TOOL_PREFIX=
# MCPDR_BUS_CAPACITY=2000
# MCPDR_MEDIA_IMAGE=inline
# MCPDR_MEDIA_AUDIO=skip
# MCPDR_LOG_LEVEL=info
# MCPDR_TZ=Asia/Taipei

# Every path is used exactly as typed: absolute, or relative to the working
# directory this process starts in. We never expand ~ — set an absolute path (or
# let your shell do the expanding) if the defaults are not where you want them.
# The built-in defaults are plain names, so untouched they land in the cwd.
# MCPDR_MEDIA_OUT=/var/lib/mcpdr/media
# What the agent is TOLD a saved file is called. --local-path is an alias you
# promise is reachable inside --file-root: only you know how the real --media-out
# directory looks from there (it may even be a bind mount), so we never try to
# work it out. Empty = derive from --media-out (relative: itself, absolute: its
# last element). The agent receives "<local-path>/<token>-<filename>"; the token
# is hashed from a per-process secret with the attachment id, so nobody can guess
# a file name from the outside, while the same attachment polled twice still maps
# to the same file (no pile of copies).
# MCPDR_LOCAL_PATH=/dc-cache
# MCPDR_MEDIA_SAVE_MAX_BYTES=4194304   # per saved attachment; -1 no limit, 0 save off
# Repeat --file-root to allow several directories; an attachment path is tried
# against them in the order declared, first hit wins. Inside a root, paths use /
# only, are cleaned ("./a/../b" is just "b"), and a leading / just means that
# root (/pose.png == pose.png); a .. that would leave the root and ~ are refused.
# Never set a root to / unless you accept that anything the process can read can
# be uploaded.
# MCPDR_FILE_ROOT=/srv/agent-out
# MCPDR_FILE_ROOT=/srv/agent-refs
# MCPDR_NO_FILE_ROOT=true   # forbid reading any local file: url targets only

# Inbound (discord_poll). A poll blocks until this agent's queue has something,
# then hands the messages over and removes them — taking them is the
# acknowledge, so nothing is stored between calls and a restart empties the
# queues. max_wait is clamped to [POLL_MIN_WAIT, POLL_MAX_WAIT]; POLL_MAX_BYTES
# is the size cap of one reply (the rest stay queued, in order, for the next
# poll), POLL_JITTER_PCT spreads the deadline of many concurrent pollers.
# MCPDR_POLL_DEFAULT_WAIT=45
# MCPDR_POLL_MIN_WAIT=5
# MCPDR_POLL_MAX_WAIT=600
# MCPDR_POLL_JITTER_PCT=15
# MCPDR_POLL_MAX_BYTES=16384

# Set true to drop the only PRIVILEGED intent this server asks for. MESSAGE_CREATE
# then arrives with empty content: 'text' will always be "" while mentions,
# attachments and embeds still come through (a poll proves something arrived, not
# what was said). Use it when the bot is not granted Message Content in the
# Developer Portal — requesting an ungranted privileged intent is what gets the
# gateway connection closed.
# MCPDR_NO_MESSAGE_CONTENT=true

# Outbound discipline (discord_send). The budget is per process and per minute;
# --send-gap-ms is the minimum spacing between two sends into the same channel;
# after --breaker-errors consecutive 429s sending pauses for 60s and every call
# is refused without touching Discord; --send-retry-wait-ms is the largest
# retry_after we absorb by waiting ourselves, anything bigger is reported back to
# the model as data instead of silently blocking the tool call.
# MCPDR_MAX_SENDS_PER_MIN=20
# MCPDR_SEND_GAP_MS=250
# MCPDR_BREAKER_ERRORS=3
# MCPDR_SEND_RETRY_WAIT_MS=1500
# MCPDR_MAX_UPLOAD_BYTES=8388608
# MCPDR_MAX_FILES_PER_MSG=10
