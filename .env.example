# Copy to .env and fill in. The token is read ONLY from the environment (or this
# file) — never from a command line value, so it cannot leak through `ps`.
# .env is git-ignored; it is applied without overriding variables you exported
# yourself (real environment wins).

DISCORD_TOKEN=Bot 0123456789abcdef.GHIJKL.mnopqrstuvwxyz0123456789

# Any command line flag can also be set here as MCPDR_<FLAG, dashes → underscores>.
# Command line beats environment beats this file.
# MCPDR_AGENT=default
# MCPDR_BUS_CAPACITY=2000
# MCPDR_MEDIA_IMAGE=inline
# MCPDR_MEDIA_AUDIO=skip
# MCPDR_LOG_LEVEL=info
# MCPDR_TZ=Asia/Taipei

# Every path is used exactly as typed: absolute, or relative to the working
# directory this process starts in. We never expand ~ — set an absolute path (or
# let your shell do the expanding) if the defaults are not where you want them.
# The built-in defaults are plain names, so untouched they land in the cwd.
# MCPDR_STATE_FILE=/var/lib/mcpdr/state.json
# MCPDR_MEDIA_OUT=/var/lib/mcpdr/media
# MCPDR_FILE_ROOT=/srv/agent-out
